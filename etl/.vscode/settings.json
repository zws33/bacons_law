{
  // Pin the interpreter to the uv-managed venv.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // Disable Pylance as the language server so basedpyright is the sole
  // typechecker + IntelliSense provider.
  "python.languageServer": "None",

  // Use the basedpyright/ruff installed in the venv (basedpyright 1.39.9,
  // ruff 0.15.20) instead of each extension's bundled copy
  "basedpyright.importStrategy": "fromEnvironment",
  "ruff.importStrategy": "fromEnvironment",
  "python.analysis.typeCheckingMode": "off",
  "python.testing.pytestArgs": ["tests"],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true
}
