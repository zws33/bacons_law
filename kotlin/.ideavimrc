" ============================================================
" .ideavimrc — LazyVim-inspired IdeaVim config
" Target: IntelliJ IDEA / Android Studio
"
" Required Marketplace plugins (Settings > Plugins > Marketplace):
"   - IdeaVim          (base, already installed if you're here)
"   - IdeaVim-EasyMotion  (for <leader>j jump)
"   - AceJump             (required by EasyMotion above)
"   - Which Key           (popup for leader key hints)
" ============================================================

" ============================================================
" PLUGINS (built-in emulation — no Marketplace install needed)
" ============================================================
set surround          " cs"', ds(, ysiw[  etc.
set commentary        " gcc, gc<motion>
set sneak             " s{char}{char} two-char jump
set argtextobj        " via / daa argument text objects
set textobj-entire    " ae/ie whole-buffer text objects
set highlightedyank   " flash on yank
set matchit           " % jumps HTML/XML tags
set ideajoin          " smart J (IDE-aware line joining)
set ideamarks         " sync vim marks <-> IDE bookmarks
set nerdtree          " NERDTree file explorer

" ============================================================
" OPTIONS
" ============================================================
set number
set relativenumber
set scrolloff=8
set sidescrolloff=8
set showmode
set showcmd
set ignorecase
set smartcase
set incsearch
set hlsearch

" Use system clipboard; ideaput makes p/P use IDE paste (respects formatters)
set clipboard+=unnamed
set clipboard+=ideaput

" Stay in normal mode during rename/refactor dialogs instead of switching to select
set idearefactormode=keep

" Keeps vim keybindings active inside single-line dialog inputs
set ideaenabledbufs+=singleline

" Persist more undo history
set undolevels=10000

" ============================================================
" LEADER
" ============================================================
let mapleader = " "
let maplocalleader = ","

" ============================================================
" KEY CONFLICT RESOLUTION
" Give these keys to Vim in normal + visual + insert modes.
" Without this, IntelliJ intercepts them before IdeaVim sees them.
" ============================================================
sethandler <C-d> a:vim
sethandler <C-u> a:vim
sethandler <C-o> a:vim
sethandler <C-i> a:vim
sethandler <C-h> n-v:vim
sethandler <C-j> n-v:vim
sethandler <C-k> n-v:vim
sethandler <C-l> n-v:vim

" ============================================================
" BASIC MOTIONS
" ============================================================
" H/L as line start/end (LazyVim default feel)
nnoremap H ^
nnoremap L $

" Keep cursor centred during scroll and search jumps
nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz
nnoremap n nzz
nnoremap N Nzz

" Y yanks to end of line (Neovim default)
nnoremap Y y$

" Clear search highlight
nmap <esc> :nohlsearch<CR>
nmap <leader>ur :nohlsearch<CR>

" ============================================================
" JUMP HISTORY — unified with IDE Back/Forward
" ============================================================
nmap <C-o> <Action>(Back)
nmap <C-i> <Action>(Forward)

" ============================================================
" WINDOW / SPLIT NAVIGATION
" ============================================================
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

nmap <leader>wv <Action>(SplitVertically)
nmap <leader>ws <Action>(SplitHorizontally)
nmap <leader>wc <Action>(Unsplit)
nmap <leader>wp <Action>(MoveEditorToOppositeTabGroup)

" Resize splits with Ctrl+Arrow (optional; comment out if conflicts arise)
nmap <C-Down>  <Action>(StretchSplitToBottom)
nmap <C-Up>    <Action>(StretchSplitToTop)
nmap <C-Left>  <Action>(StretchSplitToLeft)
nmap <C-Right> <Action>(StretchSplitToRight)

" ============================================================
" BUFFER / TAB NAVIGATION
" ============================================================
nmap [b <Action>(PreviousTab)
nmap ]b <Action>(NextTab)
nmap <leader>bC <Action>(CloseContent)
nmap <leader>bc <Action>(CloseAllEditorsButActive)
nmap <leader>bl <Action>(CloseAllToTheLeft)
nmap <leader>br <Action>(CloseAllToTheRight)

" ============================================================
" MOVE LINES (Alt-j/k like in LazyVim)
" ============================================================
nmap <A-j> <Action>(MoveLineDown)
nmap <A-k> <Action>(MoveLineUp)
imap <A-j> <Esc><Action>(MoveLineDown)i
imap <A-k> <Esc><Action>(MoveLineUp)i
vmap <A-j> :m '>+1<CR>gv=gv
vmap <A-k> :m '<-2<CR>gv=gv

" ============================================================
" EDITING QUALITY OF LIFE
" ============================================================
" Keep register clean when changing/deleting words
nnoremap ciw "_ciw
nnoremap caw "_caw
nnoremap C "_C
nnoremap cc "_cc

" Replace word under cursor with yanked text
nnoremap <leader>rw "_diwP

" Indent and stay in visual mode
vnoremap < <gv
vnoremap > >gv

" Escape from insert mode
inoremap jk <Esc>
vnoremap jk <Esc>

" ============================================================
" FOLDS
" ============================================================
nnoremap za <Action>(ExpandCollapseToggleAction)
nnoremap zM <Action>(CollapseAllRegions)
nnoremap zR <Action>(ExpandAllRegions)

" ============================================================
" FILE EXPLORER (NERDTree)
" ============================================================
nmap <leader>e <Action>(ActivateProjectToolWindow)
nmap <leader>o :NERDTreeFocus<CR>

" ============================================================
" FIND / SEARCH (LazyVim <leader>f* style)
" ============================================================
nmap <leader>ff <Action>(GotoFile)
nmap <leader>fw <Action>(FindInPath)
nmap <leader>fW <Action>(ReplaceInPath)
nmap <leader>fs <Action>(GotoSymbol)
nmap <leader>fe <Action>(GotoClass)
nmap <leader>fa <Action>(GotoAction)
nmap <leader>fh <Action>(RecentFiles)
nmap <leader>fm <Action>(RecentLocations)
nmap <leader>fb <Action>(Switcher)
nmap <leader>fp <Action>(ManageRecentProjects)
nmap <leader>ft <Action>(ActivateTerminalToolWindow)
nmap <leader>fr :registers<CR>
nmap <leader>fk :map<CR>

" ============================================================
" LSP-STYLE CODE NAVIGATION (gd, gr, gi, gy etc.)
" ============================================================
nmap gd <Action>(GotoDeclaration)
nmap gD <Action>(GotoDeclaration)
nmap gr <Action>(FindUsages)
nmap gi <Action>(GotoImplementation)
nmap gy <Action>(GotoTypeDeclaration)
nmap gs <Action>(GotoSuperMethod)
nmap gK <Action>(ShowHoverInfo)
nmap K  <Action>(ShowHoverInfo)

" Diagnostics (]d/[d like LazyVim)
nmap ]d <Action>(GotoNextError)
nmap [d <Action>(GotoPreviousError)
nmap ]e <Action>(GotoNextError)
nmap [e <Action>(GotoPreviousError)
nmap ]q <Action>(GotoNextError)
nmap [q <Action>(GotoPreviousError)

" ============================================================
" LSP ACTIONS (<leader>l* style)
" ============================================================
nmap <leader>la  <Action>(ShowIntentionActions)
vmap <leader>la  <Action>(ShowIntentionActions)
nmap <leader>lr  <Action>(RenameElement)
nmap <leader>lf  <Action>(ReformatCode)
vmap <leader>lf  <Action>(ReformatCode)
nmap <leader>lo  <Action>(OptimizeImports)
nmap <leader>ld  <Action>(ShowErrorDescription)
nmap <leader>lD  <Action>(ActivateProblemsViewToolWindow)
nmap <leader>lh  <Action>(ParameterInfo)
nmap <leader>lR  <Action>(FindUsages)
nmap <leader>lu  <Action>(HighlightUsagesInFile)

" ============================================================
" REFACTORING (<leader>r*)
" ============================================================
nmap <leader>r  <Action>(RefactoringMenu)
vmap <leader>r  <Action>(RefactoringMenu)
nmap <leader>rn <Action>(RenameElement)
nmap <leader>rv <Action>(IntroduceVariable)
nmap <leader>rc <Action>(IntroduceConstant)
nmap <leader>rf <Action>(IntroduceField)
nmap <leader>rp <Action>(IntroduceParameter)
nmap <leader>rx <Action>(ExtractMethod)
nmap <leader>ri <Action>(Inline)
nmap <leader>rs <Action>(ChangeSignature)
nmap <leader>rm <Action>(Move)

" ============================================================
" GIT (<leader>g*)
" ============================================================
nmap <leader>gg <Action>(ActivateCommitToolWindow)
nmap <leader>gb <Action>(Annotate)
nmap <leader>gB <Action>(Vcs.Show.Log)
nmap <leader>gf <Action>(Vcs.ShowTabbedFileHistory)
nmap <leader>gl <Action>(Vcs.Show.Log)
nmap <leader>gd <Action>(Compare.LastVersion)
nmap ]g         <Action>(NextDiff)
nmap [g         <Action>(PreviousDiff)

" ============================================================
" RUN / DEBUG (<leader>d*)
" ============================================================
nmap <leader>dr <Action>(Run)
nmap <leader>dR <Action>(ChooseRunConfiguration)
nmap <leader>de <Action>(Debug)
nmap <leader>dE <Action>(ChooseDebugConfiguration)
nmap <leader>dk <Action>(Stop)
nmap <leader>db <Action>(ToggleLineBreakpoint)
nmap <leader>dB <Action>(AddConditionalBreakpoint)
nmap <leader>dm <Action>(XDebugger.MuteBreakpoints)
nmap <leader>dd <Action>(Debugger.RemoveAllBreakpoints)
nmap <leader>ds <Action>(ViewBreakpoints)
nmap <leader>dO <Action>(StepOver)
nmap <leader>di <Action>(StepInto)
nmap <leader>do <Action>(StepOut)
nmap <leader>dc <Action>(Resume)
nmap <leader>dC <Action>(ForceRunToCursor)
nmap <leader>dx <Action>(EvaluateExpression)
vmap <leader>dx <Action>(EvaluateExpression)
nmap <leader>du <Action>(ActivateDebugToolWindow)
nmap <leader>dp <Action>(Pause)

" ============================================================
" TESTING (<leader>t*)
" ============================================================
nmap <leader>tt <Action>(RunClass)
nmap <leader>tT <Action>(RunAllTests)
nmap <leader>tr <Action>(Run)
nmap <leader>td <Action>(ChooseDebugConfiguration)
nmap <leader>ts <Action>(ShowTestSummary)
nmap <leader>tS <Action>(Stop)

" ============================================================
" VIEWS / TOOL WINDOWS (<leader>v*)
" ============================================================
nmap <leader>vf <Action>(ActivateProjectToolWindow)
nmap <leader>vp <Action>(ActivateProblemsViewToolWindow)
nmap <leader>vs <Action>(ActivateStructureToolWindow)
nmap <leader>vt <Action>(ActivateTerminalToolWindow)
nmap <leader>vg <Action>(ActivateVersionControlToolWindow)
nmap <leader>vd <Action>(ActivateDebugToolWindow)
nmap <leader>vq <Action>(CloseActiveTab)

" ============================================================
" UI TOGGLES (<leader>u*)
" ============================================================
nmap <leader>ul <Action>(EditorToggleShowLineNumbers)
nmap <leader>uL :set relativenumber!<CR>
nmap <leader>uw :setlocal wrap!<CR>
nmap <leader>ub <Action>(QuickChangeScheme)
nmap <leader>uD <Action>(ClearAllNotifications)
nmap <leader>md <Action>(ToggleDistractionFreeMode)
nmap <leader>mz <Action>(ToggleZenMode)
nmap <leader>mf <Action>(ToggleFullScreen)

" ============================================================
" CODE GENERATION / STRUCTURE (<leader>s* for IntelliJ)
" ============================================================
nmap <leader>sg <Action>(Generate)
nmap <leader>sc <Action>(GenerateConstructor)
nmap <leader>sG <Action>(GenerateGetterAndSetter)
nmap <leader>se <Action>(GenerateEquals)
nmap <leader>so <Action>(OverrideMethods)
nmap <leader>sn <Action>(NewClass)
nmap <leader>sf <Action>(NewFile)
nmap <leader>sx <Action>(FileStructurePopup)

" ============================================================
" RELOAD IDEAVIMRC
" ============================================================
nmap <leader>9 :source ~/.ideavimrc<CR>

" ============================================================
" EASYMOTION (requires IdeaVim-EasyMotion + AceJump plugins)
" ============================================================
set easymotion
nmap <leader>j <Plug>(easymotion-s)   " jump anywhere, one char trigger
map  \\        <Action>(AceAction)    " AceJump direct trigger

" ============================================================
" WHICH-KEY (requires Which Key plugin from Marketplace)
" Shows a popup of available bindings as you type the leader.
" ============================================================
set which-key
set notimeout
let g:WhichKey_DefaultDelay    = 400
let g:WhichKey_FontSize        = 16
let g:WhichKey_CommandColor    = "#41ead4"
let g:WhichKey_PrefixColor     = "#f335b2"
let g:WhichKey_SortOrder       = "by_key_prefix_first"
let g:WhichKey_ShowVimActions  = "false"

" Group labels
let g:WhichKeyDesc_leader         = "<leader>  Leader"
let g:WhichKeyDesc_leader_find    = "<leader>f  Find/Telescope"
let g:WhichKeyDesc_leader_lsp     = "<leader>l  LSP / Code"
let g:WhichKeyDesc_leader_refact  = "<leader>r  Refactor"
let g:WhichKeyDesc_leader_git     = "<leader>g  Git"
let g:WhichKeyDesc_leader_debug   = "<leader>d  Debug/Run"
let g:WhichKeyDesc_leader_test    = "<leader>t  Test"
let g:WhichKeyDesc_leader_view    = "<leader>v  Views"
let g:WhichKeyDesc_leader_window  = "<leader>w  Windows/Splits"
let g:WhichKeyDesc_leader_buffer  = "<leader>b  Buffers/Tabs"
let g:WhichKeyDesc_leader_ui      = "<leader>u  UI Toggles"
let g:WhichKeyDesc_leader_source  = "<leader>s  Generate (Source)"
let g:WhichKeyDesc_leader_mode    = "<leader>m  Display Modes"
let g:WhichKeyDesc_easymotion     = "<leader>j  Jump (EasyMotion)"
