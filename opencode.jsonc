{
  "$schema": "https://opencode.ai/config.json",

  // The `ollama` provider and default model are inherited from the global
  // ~/.config/opencode/opencode.jsonc. This project file only adds a read-only
  // "tutor" agent for hand-implementing the ETL (learning goal: Zach types the code).
  //
  // Use it with:  opencode --agent tutor   (or pick it via the agent switcher / Tab).
  // The default agentic model stays available for the rare times you want execution.
  "agent": {
    "tutor": {
      "description": "Socratic coach for hand-implementing the ETL — explains and reviews code, never writes it",
      "mode": "primary",
      "model": "ollama/qwen3-coder:30b",
      "temperature": 0.3,
      "prompt": "{file:./.opencode/prompts/tutor.md}",
      "permission": {
        "edit": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "task": "deny",
        "bash": "ask"
      }
    }
  }
}
